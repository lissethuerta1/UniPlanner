<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Registrar Tarea"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@color/black"
            android:layout_marginBottom="4dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Asigna un nuevo deber escolar"
            android:textSize="14sp"
            android:textColor="#64748B"
            android:layout_marginBottom="24dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Título de la actividad *"
            android:textStyle="bold"
            android:textColor="#475569"
            android:layout_marginBottom="6dp"/>
        <EditText
            android:id="@+id/etRegTitulo"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:hint="Ej. Proyecto Final"
            android:background="@android:drawable/editbox_background"
            android:paddingHorizontal="12dp"
            android:inputType="textCapSentences"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Asociar a Materia *"
            android:textStyle="bold"
            android:textColor="#475569"
            android:layout_marginBottom="6dp"/>
        <EditText
            android:id="@+id/etRegMateria"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:hint="Ej. Informática"
            android:background="@android:drawable/editbox_background"
            android:paddingHorizontal="12dp"
            android:inputType="textCapWords"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Fecha de entrega *"
            android:textStyle="bold"
            android:textColor="#475569"
            android:layout_marginBottom="6dp"/>
        <EditText
            android:id="@+id/etRegFecha"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:hint="Ej. 2026-06-15"
            android:background="@android:drawable/editbox_background"
            android:paddingHorizontal="12dp"
            android:inputType="date"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Detalles o anotaciones"
            android:textStyle="bold"
            android:textColor="#475569"
            android:layout_marginBottom="6dp"/>
        <EditText
            android:id="@+id/etRegDescripcion"
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:hint="Escribe aquí las especificaciones..."
            android:background="@android:drawable/editbox_background"
            android:padding="12dp"
            android:gravity="top"
            android:inputType="textMultiLine"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Prioridad (Ej. Alta, Normal, Baja) *"
            android:textStyle="bold"
            android:textColor="#475569"
            android:layout_marginBottom="6dp"/>
        <EditText
            android:id="@+id/etRegPriority"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:hint="Ej. Alta"
            android:background="@android:drawable/editbox_background"
            android:paddingHorizontal="12dp"
            android:inputType="textCapSentences"
            android:layout_marginBottom="24dp"/>

        <Button
            android:id="@+id/btnGuardarTarea"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:text="Guardar Actividad"
            android:backgroundTint="#6366F1"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold"/>

    </LinearLayout>
</ScrollView>